# Порт, на котором приложение слушает на хосте (0.0.0.0)
PORT=8000

# Секрет для подписи токенов — обязательно замените на длинную случайную строку
# (например: openssl rand -hex 32)
SECRET_KEY=change-me

# Первый суперюзер (создаётся при первом запуске, если суперюзеров нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too

# Начальный код регистрации для участников (потом меняется в админке)
REGISTRATION_CODE=letmein

# Максимальный размер презентации, МБ
MAX_UPLOAD_MB=300
TOKEN_TTL_HOURS=72
